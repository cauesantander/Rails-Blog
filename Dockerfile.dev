# syntax=docker/dockerfile:1
# Development/test image used by docker-compose.yml.
# The production image is defined in ./Dockerfile (generated by Rails).
ARG RUBY_VERSION=4.0.9
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# build-essential/libpq-dev/libyaml-dev: native gems (pg, psych, bcrypt...)
# libvips: Active Storage image variants (avatar thumbnails)
# postgresql-client: `rails dbconsole` and db:prepare checks
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git curl pkg-config libpq-dev libyaml-dev libvips postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Gems live in a named volume (see docker-compose.yml) so they survive rebuilds
# and are not written into the bind-mounted source tree.
ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_JOBS=4

COPY Gemfile Gemfile.lock* ./
RUN bundle install

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
