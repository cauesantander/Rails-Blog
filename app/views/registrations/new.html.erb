<% content_for :title, "Criar conta" %>

<div class="auth-box card">
  <h1>Criar conta</h1>
  <%= render "shared/errors", record: @user %>
  <%= form_with model: @user, url: registration_path do |f| %>
    <%= f.label :name, "Nome" %>
    <%= f.text_field :name, required: true, autofocus: true, maxlength: 80 %>
    <%= f.label :email_address, "E-mail" %>
    <%= f.email_field :email_address, required: true, autocomplete: "username" %>
    <%= f.label :password, "Senha (mínimo 8 caracteres)" %>
    <%= f.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
    <%= f.label :password_confirmation, "Confirme a senha" %>
    <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    <%= f.submit "Criar conta", class: "button" %>
  <% end %>
  <p class="muted">Já tem conta? <%= link_to "Entrar", new_session_path %></p>
</div>
