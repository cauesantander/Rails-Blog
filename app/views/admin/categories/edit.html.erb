<% content_for :title, "Editar categoria" %>
<h1>Editar categoria</h1>
<%= render "shared/errors", record: @category %>
<%= form_with model: [:admin, @category], class: "form-card" do |f| %>
  <%= f.label :name, "Nome" %>
  <%= f.text_field :name, required: true, maxlength: 50 %>
  <%= f.submit "Salvar", class: "button" %>
  <%= link_to "Voltar", admin_categories_path %>
<% end %>
