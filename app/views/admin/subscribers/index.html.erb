<% content_for :title, "Inscritos" %>
<h1>Inscritos da newsletter</h1>

<nav class="chips">
  <%= link_to "Todos (#{@status_counts.values.sum})", admin_subscribers_path, class: ["chip", ("chip--active" if params[:status].blank?)] %>
  <% Subscriber.statuses.each_key do |status| %>
    <%= link_to admin_subscribers_path(status:), class: ["chip", ("chip--active" if params[:status] == status)] do %>
      <%= status_badge(status) %> <%= @status_counts.fetch(status, 0) %>
    <% end %>
  <% end %>
</nav>

<%= form_with url: admin_subscribers_path, method: :get, class: "inline-form" do |f| %>
  <%= f.hidden_field :status, value: params[:status] %>
  <%= f.search_field :q, value: params[:q], placeholder: "Buscar por e-mail", "aria-label": "Buscar" %>
  <%= f.submit "Buscar", class: "button button--secondary", name: nil %>
<% end %>

<table>
  <thead><tr><th>E-mail</th><th>Status</th><th>Usuário</th><th>Inscrito em</th><th>Confirmado em</th><th></th></tr></thead>
  <tbody>
    <% @subscribers.each do |subscriber| %>
      <tr>
        <td><%= subscriber.email %></td>
        <td><%= status_badge(subscriber.status) %></td>
        <td><%= subscriber.user_id ? "sim" : "—" %></td>
        <td><%= format_time(subscriber.created_at) %></td>
        <td><%= format_time(subscriber.confirmed_at) %></td>
        <td class="actions">
          <% unless subscriber.unsubscribed? %>
            <%= button_to "Cancelar", admin_subscriber_path(subscriber), method: :patch, params: { status: "unsubscribed" }, class: "link-button" %>
          <% end %>
          <% if subscriber.pending? %>
            <%= button_to "Confirmar", admin_subscriber_path(subscriber), method: :patch, params: { status: "confirmed" }, class: "link-button" %>
          <% end %>
          <%= button_to "Excluir", admin_subscriber_path(subscriber), method: :delete, class: "link-button danger",
                form: { data: { turbo_confirm: "Excluir #{subscriber.email}? O histórico de envios é mantido." } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= paginate @subscribers %>
