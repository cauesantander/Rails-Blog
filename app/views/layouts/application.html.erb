<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Rails Blog" : "Rails Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Rails Blog">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/header" %>
    <main class="container">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
    <footer class="footer container">
      <%= render "shared/newsletter_form" %>
      <p class="muted">Rails Blog · projeto de estudo em Ruby on Rails <%= Rails.version %></p>
    </footer>
  </body>
</html>
