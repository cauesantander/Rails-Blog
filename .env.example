# Copy to .env (docker compose loads it automatically) and adjust.
# NEVER commit the .env file: it is listed in .gitignore.

# --- E-mail -------------------------------------------------------------------
# log    = development default: nothing is sent, HTML saved in tmp/mails/
# resend = real delivery through https://resend.com (requires RESEND_API_KEY)
# test   = in-memory (used automatically by the test suite)
EMAIL_PROVIDER=log
RESEND_API_KEY=
# Must be a sender from a domain verified in Resend. For a quick test without a
# domain use "Rails Blog <onboarding@resend.dev>" (Resend only delivers it to your own address).
MAIL_FROM=Rails Blog <no-reply@example.com>
EMAIL_OPEN_TIMEOUT=5
EMAIL_READ_TIMEOUT=10
# Development only: probability (0..1) of a simulated provider failure, to watch retries.
EMAIL_LOG_FAILURE_RATE=0

# Host used in links inside e-mails
APP_HOST=localhost
APP_PORT=3000
APP_PROTOCOL=http

# --- Newsletter fan-out ----------------------------------------------------------
NEWSLETTER_BATCH_SIZE=100
NEWSLETTER_BATCH_INTERVAL_SECONDS=30

# --- Sidekiq / Redis ---------------------------------------------------------------
# REDIS_URL is set by docker-compose.yml (redis://redis:6379/0). Uncomment when running outside Docker.
# REDIS_URL=redis://localhost:6379/0
SIDEKIQ_CONCURRENCY=5

# --- Database -------------------------------------------------------------------
# Set by docker-compose.yml. Outside Docker:
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=postgres
# Production: prefer DATABASE_URL=postgres://user:pass@host:5432/rails_blog_production

# --- Active Storage ----------------------------------------------------------------
# local (disk, default) | amazon (S3)
ACTIVE_STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# --- Seeds (development) ---------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password123

# --- Production only ---------------------------------------------------------------
# SECRET_KEY_BASE=   (generate with: bin/rails secret)
# RAILS_ENV=production
# FORCE_SSL=true
# ASSUME_SSL=true
